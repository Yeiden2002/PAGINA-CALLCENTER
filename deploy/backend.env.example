NODE_ENV=production
# Render asigna PORT automáticamente; el servidor escucha en 0.0.0.0.
MONGODB_URI=mongodb+srv://<DB_USER>:<DB_PASSWORD_URL_ENCODED>@<ATLAS_HOST>/asesores_horarios?retryWrites=true&w=majority
FRONTEND_URL=https://<FRONTEND>.onrender.com
TRUST_PROXY=render
STORAGE_PROVIDER=r2
R2_ACCOUNT_ID=<ACCOUNT_ID>
R2_ACCESS_KEY_ID=<ACCESS_KEY_ID>
R2_SECRET_ACCESS_KEY=<SECRET_ACCESS_KEY>
R2_BUCKET=ead-originales
# Opcional: se deriva de R2_ACCOUNT_ID. Endpoint S3 global, sin nombre de bucket.
# R2_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
